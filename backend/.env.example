# Garmin Connect credentials
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password

# Optional: path to store OAuth tokens (default: ~/.garminconnect)
# GARMIN_TOKEN_STORE=~/.garminconnect

# ----- LLM coach (OpenAI-compatible endpoint; host-swappable) -----
# Point these at whatever runs the model. Defaults target a local Ollama.
# On the Mac: install Ollama, `ollama pull llama3.1:8b`, and leave the default
# base URL. Any OpenAI-compatible server works (mlx-lm, LM Studio, llama.cpp).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=ollama   # Ollama ignores this; kept for OpenAI-compatible shape

# ----- Strava (optional; activity history + incremental sync) -----
# Create an app at https://www.strava.com/settings/api with
# Authorization Callback Domain = localhost, then run: python strava_sync.py --auth
# Historic backfill is better done from the bulk export: python strava_import.py <zip>
# STRAVA_CLIENT_ID=12345
# STRAVA_CLIENT_SECRET=your_client_secret
# STRAVA_AUTO_SYNC=1   # include Strava in the scheduled sync once authorized

# ----- Training load (optional) -----
# Max HR for heart-rate TRIMP. Default: the highest plausible value seen in
# your activities/wellness. Set it if a lab/field test gave you a real number.
# ATHLETE_MAX_HR=190
# TRIMP curve: Banister's "male" (default) or "female" coefficients.
# TRIMP_SEX=male
