<?xml version="1.0" encoding="utf-8"?>
<!-- Health data stays on this phone. Nothing is copied to cloud backups or to
     a new phone in a device-to-device transfer: the database is encrypted
     with a key in this phone's keystore, so a copy could never be read, and
     its contents come back by importing again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
